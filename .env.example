# WordPress site URL. Do not include /wp-json.
WP_URL=https://example.com

# application_password: WordPress 5.6+ native, no plugin required
# jwt: use only when the WordPress site already exposes a JWT-compatible endpoint
WP_AUTH_METHOD=application_password

# Application Password mode
WP_USERNAME=your-wordpress-username
WP_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# JWT mode (uncomment when WP_AUTH_METHOD=jwt)
# WP_JWT_TOKEN=your-existing-wordpress-jwt

# REST content types that tools may access. Each value becomes /wp-json/wp/v2/<type>.
WP_CONTENT_TYPES=posts,pages

# Server
TRANSPORT=http
HOST=0.0.0.0
PORT=3000
BIND_ADDRESS=127.0.0.1
MCP_PATH=/mcp

# Optional shared bearer token protecting the MCP HTTP endpoint.
# Leave empty for local/private-network use. For public ChatGPT use, OAuth at a gateway is preferred.
# MCP_API_KEY=replace-with-a-long-random-secret

# Comma-separated Host header hostname allow-list (without scheme or port).
# Required when exposing directly to the internet.
ALLOWED_HOSTS=localhost,127.0.0.1

# Limits
REQUEST_TIMEOUT_MS=30000
MAX_MEDIA_BYTES=10485760
LOG_LEVEL=info
